    { "from": "maker.repair",         "to": "retro.recapping",      "kind": "shares-gear", "note": "Capacitores, flux y malla son los mismos; la consola es solo la placa de esta semana en la mesa." },
    { "from": "maker.repair",         "to": "coffee.maintenance",   "kind": "kin",         "note": "Ambos son trabajo de empaques, filtros y diagramas de repuestos en una máquina que otro declaró muerta." },
    { "from": "maker.sensors",        "to": "coffee.machine-mods",  "kind": "shares-gear", "note": "El mod PID que corrige una temperatura errática es un termopar y un lazo de control, o sea un martes cualquiera en esta repisa." },
    { "from": "maker.soldering-bench","to": "music.pedals",         "kind": "shares-gear", "note": "El mismo cautín y el mismo flux, apuntados a un kit through-hole que hace ruido cuando funciona." },
    { "from": "maker.soldering-bench","to": "retro.modding",        "kind": "shares-gear", "note": "Aire caliente, flux y buena luz. Mods de paso fino en una placa de la que no puedes comprar otra." },
    { "from": "maker.soldering-bench","to": "game.controllers",     "kind": "shares-gear", "note": "Cambiar un stick es trabajo de desoldar. La malla y la bomba viven en esta mesa." },
    { "from": "maker.power",          "to": "drone.lipo",           "kind": "shares-gear", "note": "Celdas, cargadores y voltajes de corte son un solo tema; el quad solo las drena más rápido." },
    { "from": "maker.printer-tuning", "to": "figure.printed-minis", "kind": "shares-gear", "note": "Una prueba de exposición es una torre de temperatura en resina. Calibra primero, luego imprime la mini." },
    { "from": "maker.cad",            "to": "brick.stud-io",        "kind": "kin" },
    { "from": "maker.pcb-design",     "to": "music.modular",        "kind": "shares-gear", "note": "Un módulo Eurorack es un PCB con panel. La misma fábrica envía ambos por el precio de una pizza." },
    { "from": "maker.pcb-design",     "to": "retro.mechanical-kb",  "kind": "shares-gear", "note": "Un teclado es una matriz de switches sobre un PCB. Mismos gerbers, mismas cinco placas de la fábrica." },
    { "from": "maker.laser-cnc",      "to": "tabletop.terrain",     "kind": "shares-gear", "note": "Un kit de ruinas es lámina plana anidada. El mismo láser que corta cajas corta un campo de batalla." },
    { "from": "maker.arduino",        "to": "astro.mounts",         "kind": "shares-gear", "note": "Un tracker de puerta de granero son dos tablas, una varilla roscada y un stepper. La primera luz de la electrónica de mucha gente." },

    { "from": "rail.weathering",  "to": "model.airbrush-rig",  "kind": "shares-gear", "note": "El óxido en un vagón y el hollín en un mecha son las mismas tres técnicas con distintas fotos de referencia." },
    { "from": "rail.scenery",     "to": "model.dioramas",      "kind": "kin" },
    { "from": "rail.structures",  "to": "tabletop.terrain",    "kind": "shares-gear", "note": "Cartón, estireno y madera cortada a láser arman un pueblo a 1/87 o una ruina que disputar. Misma mesa." },
    { "from": "rail.locos",       "to": "brick.trains",        "kind": "kin",         "note": "Dos formas de correr un tren en una mesa. Uno va pegado a 1/87, el otro se desarma y se reconstruye." },
    { "from": "rail.cab-camera",  "to": "video.videography",   "kind": "leads-to" },
    { "from": "rail.railfanning", "to": "drone.cinematic",     "kind": "shares-gear", "note": "El dron es del ferrocarril real, no del de maqueta. Nadie filma una maqueta desde el aire." },
    { "from": "rail.railfanning", "to": "music.field-recording","kind": "shares-gear","note": "Grabar el sonido del tren real es un hobby viejo y aparte, y usa la misma grabadora y el mismo paravientos." },

    { "from": "figure.mini-painting","to": "tabletop.warhammer",  "kind": "shares-gear", "note": "Las pinturas, los pinceles y la paleta húmeda son idénticos. Solo cambia la razón de la miniatura." },
    { "from": "figure.army-painting","to": "tabletop.tournaments","kind": "kin",         "note": "La fecha del torneo es el único deadline de este hobby, y es la razón de que los ejércitos se terminen." },
    { "from": "figure.collecting",   "to": "anime.merch",        "kind": "kin" },
    { "from": "figure.garage-kits",  "to": "anime.conventions",  "kind": "kin",         "note": "Los garage kits se venden en tirajes cortos en eventos, y de ahí viene el nombre." },
    { "from": "figure.basing",       "to": "model.dioramas",     "kind": "kin" },
    { "from": "figure.casting",      "to": "cosplay.molding",    "kind": "shares-gear", "note": "Misma silicona, misma resina, misma olla de presión; uno llena una repisa, el otro un disfraz." },
    { "from": "figure.figure-photo", "to": "video.macro",        "kind": "shares-gear", "note": "Mismo lente macro, mismo sujeto diminuto, mismo problema de profundidad de campo. El apilado arregla ambos." },
    { "from": "figure.articulated",  "to": "anime.mecha",        "kind": "kin" },

    { "from": "video.videography",  "to": "drone.cinematic",   "kind": "shares-gear", "note": "Un dron es un slider con altura. Las decisiones de encuadre y cobertura son el mismo trabajo." },
    { "from": "drone.cinematic",    "to": "video.editing",     "kind": "leads-to" },
    { "from": "video.audio-capture","to": "music.recording",   "kind": "shares-gear", "note": "Colocar micrófonos y pelear con una sala que no ayuda. Que alimente un DAW o una edición es un detalle." },
    { "from": "video.streaming",    "to": "game.co-op",        "kind": "kin" },
    { "from": "video.macro",        "to": "astro.stacking",    "kind": "kin",         "note": "Matemática distinta, mismo instinto: muchos cuadros le ganan a uno, y la computadora decide qué partes están nítidas." },
    { "from": "video.timelapse",    "to": "astro.astrophoto",  "kind": "kin" },

    { "from": "film.practical-fx", "to": "starwars.props",   "kind": "shares-gear", "note": "Replicar props es efectos prácticos hechos despacio, por una persona, para una repisa en vez de una cámara." },
    { "from": "film.kaiju",        "to": "anime.mecha",      "kind": "kin" },
    { "from": "film.animation",    "to": "anime.films",      "kind": "kin" },
    { "from": "film.soundtracks",  "to": "music.vinyl",      "kind": "kin" },
    { "from": "film.projection",   "to": "retro.crt",        "kind": "kin" },
    { "from": "film.practical-fx", "to": "cosplay.makeup",   "kind": "kin" },
    { "from": "film.home-cinema",  "to": "music.hifi",       "kind": "shares-gear", "note": "Mismo amplificador, mismas bocinas, misma pelea por la sala. Uno de los dos agrega pantalla." },

    { "from": "anime.jpop",        "to": "music.vinyl",         "kind": "kin" },
    { "from": "anime.conventions", "to": "cosplay.competition", "kind": "kin" },

    { "from": "tabletop.game-design",  "to": "game.gamedev",        "kind": "kin" },
    { "from": "tabletop.ttrpg",        "to": "game.arpg",           "kind": "kin",  "note": "Ambos son builds de personaje. Uno se negocia con una persona, el otro con una hoja de cálculo." },
    { "from": "tabletop.list-building","to": "game.build-crafting", "kind": "kin",  "note": "Optimizar dentro de un presupuesto de puntos, con una comunidad que lo discute. Mismo hobby, distinta mesa." },

    { "from": "brick.mindstorms", "to": "maker.robotics",  "kind": "kin" },
    { "from": "brick.dioramas",   "to": "model.dioramas",  "kind": "kin" },

    { "from": "cosplay.weathering", "to": "model.airbrush-rig", "kind": "shares-gear", "note": "Mismo aerógrafo, misma mugre diluida; el panel es del tamaño del pecho y no del pulgar." },

    { "from": "music.chiptune", "to": "retro.demoscene", "kind": "kin" },

    { "from": "retro.emulation",    "to": "game.preservation", "kind": "kin" },
    { "from": "retro.mechanical-kb","to": "game.pc-building",  "kind": "kin" },
    { "from": "game.simracing",     "to": "drone.simulator",   "kind": "kin",  "note": "Ambos descubrieron que las horas más baratas son las simuladas, y ambas comunidades discuten si cuentan." },

    { "from": "astro.satellite-spot","to": "radio.satellites",  "kind": "kin",         "note": "Uno lo ve cruzar y el otro habla a través de él. Mismo paso, mismas tablas de predicción, mismos diez minutos." },
    { "from": "astro.solar",         "to": "radio.propagation", "kind": "kin",         "note": "El flujo solar y el número de manchas son los mismos números en ambas portadas, leídos por razones opuestas." },
    { "from": "astro.dark-sky",      "to": "radio.pota",        "kind": "shares-gear", "note": "Una mochila, un sitio sin interferencia y un viaje largo. La logística es idéntica y la carga no." },
    { "from": "drone.video-link",    "to": "radio.antennas",    "kind": "shares-gear", "note": "Polarización, ganancia y SWR a 5.8 GHz. Es trabajo de antenas con un cuadricóptero colgando." },
    { "from": "drone.regulations",   "to": "radio.ham",         "kind": "kin",         "note": "Casi todo transmisor de video de 5.8 GHz excede el límite sin licencia, así que la vía legal al buen equipo es la licencia Technician." },

    { "from": "astro.scope-building", "to": "model.scale-armour",   "kind": "shares-gear", "note": "El Gunpla lija una unión de 400 a 2000, el espejero va de grano 80 a 3 micras. Misma regla: nunca saltes un grado." },
    { "from": "model.gunpla",         "to": "figure.competition",   "kind": "kin",         "note": "El mundial se juzga por fotos enviadas. La foto es la inscripción, y el modelo es solo lo que estuvo frente a la cámara." },
    { "from": "video.lighting",       "to": "rail.scenery",         "kind": "shares-gear", "note": "Difuminar una luz principal sobre una escena de quince centímetros es un problema muy concreto, y es el mismo en la foto de figuras." },
    { "from": "maker.laser-cnc",      "to": "rail.structures",      "kind": "shares-gear", "note": "Lámina plana, piezas anidadas y pestañas. Papercraft, cajas y escenografía láser son una sola habilidad con tres abrigos." },
    { "from": "brick.trains",         "to": "rail.layout",          "kind": "kin",         "note": "Radio mínimo, gálibos y pendientes máximas gobiernan a ambos, y luego ambos necesitan motorización y control." },
    { "from": "radio.meshtastic",     "to": "drone.mapping",        "kind": "kin",         "note": "Ambos reportan posición donde no hay señal celular, y ambos viven o mueren por los mapas offline." },
    { "from": "cosplay.armour",       "to": "starwars.props",       "kind": "kin",         "note": "Un mismo foro aloja builds de armadura y de sables lado a lado, porque más allá del tema el acabado es un solo oficio." },
    { "from": "starwars.chassis-design","to": "maker.enclosures",   "kind": "shares-gear", "note": "Una placa, una celda, una bocina y un kill key en un tubo de 35 mm es un problema de empaque antes que de sable." },
    { "from": "starwars.soundfonts",  "to": "music.sampling",       "kind": "shares-gear", "note": "Un preset de sable es un set curado de audios. Recortarlos y nivelarlos es el mismo trabajo que picar un sample." },
    { "from": "rail.clubs",           "to": "brick.shows",          "kind": "kin",         "note": "Ambos resolvieron lo mismo con un estándar modular, así que los módulos de veinte personas se unen en una mesa de expo." },
    { "from": "figure.casting",       "to": "cosplay.makeup",       "kind": "kin",         "note": "La silicona de platino y la resina fluida sirven a garage kits, props, estatuas y prótesis desde un mismo set de habilidades." },

    { "from": "book.fiction",         "to": "hub",                  "kind": "kin" },
    { "from": "garden.houseplants",   "to": "hub",                  "kind": "kin" },
    { "from": "kitchen.cooking",      "to": "hub",                  "kind": "kin" },
    { "from": "outdoor.hiking",       "to": "hub",                  "kind": "kin" },

    { "from": "book.comics",          "to": "anime.manga",          "kind": "kin",         "note": "Cómics de la otra repisa. Los lectores cruzan todo el tiempo; solo el estante de la tienda finge lo contrario." },
    { "from": "book.bookbinding",     "to": "core.hand-tools",      "kind": "draws-on",    "note": "Plegadera, punzón, aguja y una navaja afilada. Encuadernar es trabajo manual a escala de libro." },
    { "from": "book.zines",           "to": "core.writing",         "kind": "draws-on" },
    { "from": "book.scifi",           "to": "film.scifi",           "kind": "kin",         "note": "Las mismas franquicias corren por ambos, y el libro de bolsillo casi siempre llegó primero." },
    { "from": "book.audiobooks",      "to": "video.podcasting",     "kind": "kin",         "note": "Mismos audífonos y mismo trayecto. La línea entre libro narrado y podcast largo es más delgada de lo que ambos bandos admiten." },
    { "from": "garden.hydroponics",   "to": "maker.sensors",        "kind": "shares-gear", "note": "Sondas de humedad, pH y un ESP32 registrando todo. Un rig hidropónico es un proyecto de sensores que además cultiva lechuga." },
    { "from": "garden.terrariums",    "to": "model.dioramas",       "kind": "kin",         "note": "Ambos componen un paisaje en una cajita de vidrio. Uno de los dos sigue creciendo cuando terminas." },
    { "from": "garden.aquascaping",   "to": "coffee.water",         "kind": "shares-gear", "note": "Dureza y alcalinidad con los mismos kits de gotero. Un tanque cultiva plantas, el otro saca shots." },
    { "from": "garden.vegetables",    "to": "kitchen.preserving",   "kind": "leads-to",    "note": "La cosecha de julio tiene que ir a algún lado. Los frascos son la forma en que un huerto sobrevive a su propio éxito." },
    { "from": "kitchen.food-photo",   "to": "core.photography",     "kind": "draws-on",    "note": "Luz de ventana, un reflector y un plato enfriándose. La comida es la modelo y tiene deadline." },
    { "from": "kitchen.chocolate",    "to": "coffee.roasting",      "kind": "shares-gear", "note": "Cacao y café crepitan en el mismo tambor chico y se escuchan igual. Muchos setups bean-to-bar empezaron como rigs de café." },
    { "from": "kitchen.homebrewing",  "to": "coffee.water",         "kind": "shares-gear", "note": "Mismas tiras de prueba, mismas sales minerales, misma desconfianza de la llave. Cerveceros y baristas pelean por números idénticos." },
    { "from": "kitchen.spices",       "to": "coffee.cupping",       "kind": "kin",         "note": "Ambos son hobbies de paladar entrenado con vocabulario de cata. La rueda de sabores en la pared es casi el mismo póster." },
    { "from": "outdoor.birdwatching", "to": "astro.visual",         "kind": "shares-gear", "note": "Binoculares y un telescopio terrestre en trípode sirven a ambos. Una comunidad apunta al cielo, la otra a un arbusto." },
    { "from": "outdoor.birdwatching", "to": "core.photography",     "kind": "draws-on",    "note": "Lentes largos, mala luz y un sujeto que se va. La prueba de paciencia en la que la fotografía siempre amenazó con convertirse." },
    { "from": "outdoor.geocaching",   "to": "radio.meshtastic",     "kind": "kin",         "note": "Ambos son coordenadas y mapas offline en lugares sin señal. El traslape de miembros no es coincidencia." },
    { "from": "outdoor.hiking",       "to": "radio.pota",           "kind": "kin",         "note": "Una activación POTA es un parque, una radio y diez contactos. Muchas se hacen a pie, aunque el reglamento acepta el estacionamiento." },
    { "from": "outdoor.camping",      "to": "astro.dark-sky",       "kind": "kin",         "note": "Una star party es un campamento que se queja de los faros. Mismos criterios de sitio, mismo termo." },
    { "from": "outdoor.foraging",     "to": "kitchen.fermentation", "kind": "leads-to",    "note": "Los hongos silvestres y la fruta del monte le ganan rápido al refri. Frascos y salmuera son la salida tradicional." },

    { "from": "game.jrpg",            "to": "anime.series",         "kind": "kin",         "note": "Un solo fandom con dos pantallas. La tabla de temporada y el calendario de lanzamientos los lee la misma gente la misma semana." },
    { "from": "game.rhythm",          "to": "music.dj",             "kind": "kin",         "note": "El gabinete arcade fundador era un simulador de DJ. Empatar beats es la habilidad compartida, y algunos cruzan en serio." },
    { "from": "game.vr",              "to": "film.home-cinema",     "kind": "kin",         "note": "Dos respuestas a la misma sala: una forró las paredes de bocinas, la otra despejó el piso y se amarró la pantalla a la cara." },
    { "from": "maker.keyboards",      "to": "game.pc-building",     "kind": "shares-gear", "note": "Armado en el mismo escritorio que la máquina donde se conecta, casi siempre con un mes de diferencia y con los mismos desarmadores." },
    { "from": "game.fighting",        "to": "tabletop.tournaments", "kind": "kin",         "note": "Locales, brackets y una escena llevada por voluntarios. El semanal de la tienda es la misma institución en ambos hobbies." },
    { "from": "game.mmo",             "to": "tabletop.ttrpg",       "kind": "kin",         "note": "El descendiente directo, vía los MUDs. La party, el loot y el problema de agendar sobrevivieron la mudanza a internet." },
    { "from": "maker.keyboards",      "to": "retro.mechanical-kb",  "kind": "kin",         "note": "Una escena restaura las placas que la otra está citando. Los group buys y los hallazgos de eBay acaban en el mismo desk mat." }
  ]
}
